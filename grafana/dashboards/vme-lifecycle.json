          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vme-tsdb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COALESCE(os_name, '') AS \"OS name\", COALESCE(platform, '') AS \"Platform\", COALESCE(platform_version, '') AS \"Platform version\", count(*) AS \"Servers\" FROM servers WHERE present AND (os_product IS NULL OR os_cycle IS NULL) GROUP BY 1, 2, 3 ORDER BY 4 DESC"

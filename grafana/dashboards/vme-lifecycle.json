    {
      "type": "table",
      "title": "OS releases in use",
      "description": "Lifecycle data from endoflife.date, refreshed daily.",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vme-tsdb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT s.os_product AS \"Product\", s.os_cycle AS \"Cycle\", count(*) AS \"Servers\", l.release_date AS \"Released\", l.support_date AS \"Active support ends\", l.eol_date AS \"EOL\", l.latest AS \"Latest\", l.lts AS \"LTS\" FROM servers s LEFT JOIN os_lifecycle l ON l.product = s.os_product AND lower(l.cycle) = lower(s.os_cycle) WHERE s.present AND s.os_product IS NOT NULL GROUP BY 1, 2, 4, 5, 6, 7, 8 ORDER BY 6 NULLS LAST"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "align": "auto"
          }
        },
        "overrides": []

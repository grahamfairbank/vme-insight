    {
      "type": "table",
      "title": "OS and agent currency",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "vme-tsdb"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT name AS \"Name\", kind AS \"Kind\", cluster AS \"Cluster\", host AS \"Host\", power_state AS \"Power\", COALESCE(os_name, os_product) AS \"OS\", os_version_full AS \"Version\", os_latest AS \"Latest in cycle\", os_status AS \"OS status\", eol_date AS \"EOL\", days_to_eol AS \"Days to EOL\", agent_version AS \"Morpheus agent\", agent_status AS \"Agent status\", agent_last_update AS \"Agent check-in\", guest_agent_status AS \"Guest agent\" FROM server_currency sc WHERE (-1 IN ($cluster) OR sc.cluster_id IN ($cluster)) ORDER BY CASE os_status WHEN 'end of life' THEN 0 WHEN 'eol < 180d' THEN 1 WHEN 'update available' THEN 2 ELSE 3 END, days_to_eol NULLS LAST, name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "OS status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "current": {
                        "color": "green",
                        "index": 0
                      },
                      "update available": {
                        "color": "#EAB839",
                        "index": 1
                      },
                      "eol < 180d": {
                        "color": "orange",
                        "index": 2
                      },
                      "end of life": {
                        "color": "red",
                        "index": 3
                      },
                      "outdated": {
                        "color": "orange",
                        "index": 4
                      },
                      "not installed": {
                        "color": "red",
                        "index": 5
                      },
                      "unknown": {
                        "color": "gray",
                        "index": 6
                      },
                      "unknown os": {

{
  "uid": "vme-hvm-bottlenecks",
  "title": "VME HVM Bottlenecks (exporters)",
  "tags": [
    "vme-insight",
    "exporters",
    "bottlenecks"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "graphTooltip": 1,
  "time": {
    "from": "now-3h",
    "to": "now"

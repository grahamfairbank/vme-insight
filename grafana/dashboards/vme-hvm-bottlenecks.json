    {
      "type": "timeseries",
      "title": "CPU pressure (PSI some)",
      "description": "Share of time at least one task waited for CPU. Sustained values above ~10% mean contention.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vme-prom"
          },
          "refId": "A",
          "expr": "100 * rate(node_pressure_cpu_waiting_seconds_total{source=~\"$source\", cluster=~\"$cluster\", nodename=~\"$host\"}[$__rate_interval])",
          "legendFormat": "{{nodename}}",
          "instant": false,
          "range": true,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": 300000,
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "sortBy": "Mean",
          "sortDesc": true

  "templating": {
    "list": [
      {
        "type": "query",
        "name": "source",
        "label": "Estate",
        "datasource": {
          "type": "prometheus",
          "uid": "vme-prom"
        },
        "query": {
          "query": "label_values(node_uname_info, source)",
          "refId": "source",
          "qryType": 1
        },
        "definition": "label_values(node_uname_info, source)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "type": "query",
        "name": "cluster",
        "label": "Cluster",
        "datasource": {
          "type": "prometheus",
          "uid": "vme-prom"
        },
        "query": {
          "query": "label_values(node_uname_info{source=~\"$source\"}, cluster)",
          "refId": "cluster",
          "qryType": 1
        },
        "definition": "label_values(node_uname_info{source=~\"$source\"}, cluster)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {

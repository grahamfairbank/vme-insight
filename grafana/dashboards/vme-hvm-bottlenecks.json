        "label": "Host",
        "datasource": {
          "type": "prometheus",
          "uid": "vme-prom"
        },
        "query": {
          "query": "label_values(node_uname_info{source=~\"$source\", cluster=~\"$cluster\"}, nodename)",
          "refId": "host",
          "qryType": 1
        },
        "definition": "label_values(node_uname_info{source=~\"$source\", cluster=~\"$cluster\"}, nodename)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"

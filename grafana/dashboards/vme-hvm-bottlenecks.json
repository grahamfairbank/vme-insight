    {
      "type": "bargauge",
      "title": "Host CPU % now",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vme-prom"
          },
          "refId": "A",
          "expr": "topk(15, 100 * (1 - avg by (nodename) (rate(node_cpu_seconds_total{mode=\"idle\", source=~\"$source\", cluster=~\"$cluster\", nodename=~\"$host\"}[$__rate_interval]))))",
          "legendFormat": "{{nodename}}",
          "instant": true,
          "range": false,
          "format": "time_series",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }

          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT s.name AS \"VM\", s.power_state AS \"Power\", s.status AS \"Status\", h.name AS \"Host\", cl.name AS \"Cluster\", s.ip_internal AS \"IP\", s.max_cores AS \"vCPU\", s.max_memory AS \"Memory\", s.max_storage AS \"Disk\", s.os_name AS \"OS\", s.guest_agent_status AS \"Guest agent\", s.agent_version AS \"Morpheus agent\", cd.name AS \"Cloud\", s.plan AS \"Plan\", s.source_image AS \"Image\", i.owner AS \"Owner\", s.date_created AS \"Created\" FROM servers s LEFT JOIN servers h ON h.id = s.host_id LEFT JOIN clusters cl ON cl.id = s.cluster_id LEFT JOIN instances i ON s.id = ANY(i.server_ids) AND i.present LEFT JOIN clouds cd ON cd.id = s.cloud_id WHERE s.kind = 'vm' AND s.present AND (-1 IN ($cluster) OR s.cluster_id IN ($cluster)) AND (-1 IN ($host) OR s.host_id IN ($host)) AND (-1 IN ($vm) OR s.id IN ($vm)) ORDER BY 1"

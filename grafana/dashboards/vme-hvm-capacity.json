        {
          "datasource": {
            "type": "prometheus",
            "uid": "vme-prom"
          },
          "refId": "B",
          "expr": "max by (nodename) (sum by (nodename) (libvirt_domain_info_virtual_cpus{job=~\"hvm-.*\", source=~\"$source\", cluster=~\"$cluster\", nodename=~\"$host\"} and on (nodename, domain) (libvirt_domain_info_state{job=~\"hvm-.*\", source=~\"$source\", cluster=~\"$cluster\", nodename=~\"$host\"} == 1)))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vme-prom"
          },
          "refId": "C",
          "expr": "max by (nodename) (sum by (nodename) (libvirt_domain_info_virtual_cpus{job=~\"hvm-.*\", source=~\"$source\", cluster=~\"$cluster\", nodename=~\"$host\"} and on (nodename, domain) (libvirt_domain_info_state{job=~\"hvm-.*\", source=~\"$source\", cluster=~\"$cluster\", nodename=~\"$host\"} == 1)) / count by (nodename) (node_cpu_seconds_total{mode=\"idle\", job=~\"hvm-.*\", source=~\"$source\", cluster=~\"$cluster\", nodename=~\"$host\"}))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vme-prom"
          },
          "refId": "D",
          "expr": "max by (nodename) (count by (nodename) (node_cpu_seconds_total{mode=\"idle\", job=~\"hvm-.*\", source=~\"$source\", cluster=~\"$cluster\", nodename=~\"$host\"}) * avg by (nodename) (rate(node_cpu_seconds_total{mode=\"idle\", job=~\"hvm-.*\", source=~\"$source\", cluster=~\"$cluster\", nodename=~\"$host\"}[$__rate_interval])))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vme-prom"
          },
          "refId": "E",
          "expr": "max by (nodename) (node_memory_MemTotal_bytes{job=~\"hvm-.*\", source=~\"$source\", cluster=~\"$cluster\", nodename=~\"$host\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vme-prom"
          },
          "refId": "F",
          "expr": "max by (nodename) (sum by (nodename) (libvirt_domain_info_maximum_memory_bytes{job=~\"hvm-.*\", source=~\"$source\", cluster=~\"$cluster\", nodename=~\"$host\"} and on (nodename, domain) (libvirt_domain_info_state{job=~\"hvm-.*\", source=~\"$source\", cluster=~\"$cluster\", nodename=~\"$host\"} == 1)))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vme-prom"
          },
          "refId": "G",
          "expr": "max by (nodename) (sum by (nodename) (libvirt_domain_info_maximum_memory_bytes{job=~\"hvm-.*\", source=~\"$source\", cluster=~\"$cluster\", nodename=~\"$host\"} and on (nodename, domain) (libvirt_domain_info_state{job=~\"hvm-.*\", source=~\"$source\", cluster=~\"$cluster\", nodename=~\"$host\"} == 1)) / on (nodename) node_memory_MemTotal_bytes{job=~\"hvm-.*\", source=~\"$source\", cluster=~\"$cluster\", nodename=~\"$host\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vme-prom"
          },
          "refId": "H",
          "expr": "max by (nodename) (node_memory_MemAvailable_bytes{job=~\"hvm-.*\", source=~\"$source\", cluster=~\"$cluster\", nodename=~\"$host\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "editorMode": "code"

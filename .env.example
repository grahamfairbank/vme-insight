# Copy to .env and change every password.
DB_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me-too
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-as-well
GRAFANA_PORT=3000
# Memory TimescaleDB tunes itself for (e.g. 512MB, 1GB, 4GB)
DB_MEMORY=1GB
TZ=UTC
# How long Prometheus keeps exporter data
PROM_RETENTION=90d
# Address Grafana's port is published on; 127.0.0.1 = only via the https front end from other machines
GRAFANA_BIND=0.0.0.0
# Allow Grafana panels to be embedded in other pages (e.g. a VME UI plugin)
GRAFANA_ALLOW_EMBEDDING=false
# Read-only access without signing in. Only with GRAFANA_BIND=127.0.0.1 and HTTPS_ALLOW (docs/SECURITY.md)
GRAFANA_ANONYMOUS=false
GRAFANA_ANONYMOUS_ORG="Main Org."
# Public address when using the https front end, e.g. https://vme-insight.example.com:3443/
GRAFANA_ROOT_URL=
GRAFANA_COOKIE_SECURE=false
# Optional https front end (docker compose --profile https): port, names, allowed networks, certificate
HTTPS_PORT=3443
HTTPS_HOSTNAME=localhost
HTTPS_ALLOW="127.0.0.1/32"
HTTPS_TLS=internal
# DEBUG logs every request and failed TLS handshakes (troubleshooting only)
HTTPS_LOG_LEVEL=INFO
# Port of the optional exporter installer service (docker compose --profile installer)
INSTALLER_PORT=8097

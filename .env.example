# Copy to .env and change every password.
DB_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me-too
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-as-well
GRAFANA_PORT=3000
# Memory TimescaleDB tunes itself for (e.g. 512MB, 1GB, 4GB)
DB_MEMORY=1GB
TZ=UTC
# How long Prometheus keeps exporter data
PROM_RETENTION=90d
# Allow Grafana panels to be embedded in other pages (e.g. a VME UI plugin)
GRAFANA_ALLOW_EMBEDDING=false
# Port of the optional exporter installer service (docker compose --profile installer)
INSTALLER_PORT=8097
